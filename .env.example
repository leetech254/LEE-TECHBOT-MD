# Copy this file to .env and fill in values locally or in your hosting panel.
NODE_ENV=production
BOT_NAME=LEE TECH BOT
BOT_OWNER=LEE TECH
BOT_MODE=private
PREFIX=.
MENU_USER_NAME=
# If empty, the menu uses the linked WhatsApp push name, then the linked number.
TIME_ZONE=Africa/Nairobi
OWNER_NUMBER=
SUPER_OWNER_NUMBER=
# Direct host linking: pair uses PHONE_NUMBER/PAIRING_NUMBER; qr shows a QR in the host console.
AUTH_METHOD=pair
PHONE_NUMBER=
PAIRING_NUMBER=
PAIRING_CODE=
# Set true to show the 1/2/3 startup menu in non-TTY host consoles.
SESSION_TERMINAL_PROMPT=false
AUTH_DIR=./auth
SESSION_RECOVERY_RESET=false
CHANNEL_LINK=

# Optional AI/media providers
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=700
# Optional: GROQ_SYSTEM_PROMPT=You are a helpful WhatsApp bot.
GIPHY_API_KEY=
TENOR_API_KEY=
TELEGRAM_BOT_TOKEN=
XTEAM_API_KEY=
LOLHUMAN_API_KEY=
NEOXR_API_KEY=
VIOLETICS_API_KEY=
ZENZ_API_KEY=
FGMODS_API_KEY=

# Runtime controls
COMMAND_RATE_LIMIT=8
COMMAND_RATE_WINDOW_MS=10000
LOG_LEVEL=info
USE_MOBILE=false

# Optional alias accepted by the Groq command
Copy this file to .env and add your own values.
# Never commit real API keys.

# Groq API key. The bot accepts either name; GROQ_API_KEY is preferred.
# Optional alias for users who call the provider Grok.
GROK_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_SYSTEM_PROMPT=You are a helpful WhatsApp bot.
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=700


# Serve a protected /pairing page from this bot process so linking writes directly to AUTH_DIR.
PAIRING_WEB_ENABLED=true
# Leave blank to use the platform PORT; otherwise configure/expose this port in the host panel.
PAIRING_WEB_PORT=
PAIRING_WEB_HOST=0.0.0.0
# Optional private key (24+ characters); blank generates a random key shown in host logs on each start.
PAIRING_WEB_TOKEN=

# When the host website is enabled, use /pairing as the direct linking UI.
# If disabled, the optional terminal menu is controlled by SESSION_TERMINAL_PROMPT.

GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
