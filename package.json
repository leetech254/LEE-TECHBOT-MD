{
  "name": "leetechbot",
  "version": "2.0.0",
  "description": "Premium, production-ready WhatsApp automation bot",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/start-with-session-recovery.js",
    "start:bot": "node index.js",
    "start:recovery": "node scripts/start-with-session-recovery.js",
    "start:panel": "node --max-old-space-size=512 index.js",
    "start:terminal": "node index.js",
    "start:termux": "node --max-old-space-size=512 index.js",
    "start:optimized": "node --max-old-space-size=512 --optimize-for-size --gc-interval=100 index.js",
    "cleanup": "node cleanup.js",
    "reset-session": "node reset-session.js",
    "start:clean": "npm run cleanup && npm run start:optimized",
    "start:fresh": "npm run reset-session && npm start",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node --check index.js && node --check main.js && node --check lib/hostPairing.js && node --check lib/hostPairingWeb.js && npm test",
    "audit:menu": "node scripts/audit-menu-commands.js",
    "install:panel": "npm ci --omit=dev --no-audit --no-fund --prefer-offline && (npm rebuild sharp --foreground-scripts || echo 'Warning: sharp native build unavailable; core bot remains available')",
    "install:terminal": "npm ci --no-audit --no-fund --prefer-offline && (npm rebuild sharp --foreground-scripts || echo 'Warning: sharp native build unavailable; core bot remains available')",
    "install:termux": "npm ci --omit=dev --ignore-scripts --no-audit --no-fund --prefer-offline && npx patch-package && rm -rf node_modules/sharp && echo 'Termux mode: skipped unsupported sharp native module; core bot remains available'",
    "deploy:terminal": "npm run install:terminal && npm run start:terminal",
    "deploy:termux": "npm run install:termux && npm run start:termux",
    "install:force": "npm install --force",
    "docker:build": "docker build -t leetechbot .",
    "postinstall": "patch-package"
  },
  "keywords": [
    "whatsapp-bot",
    "baileys",
    "automation"
  ],
  "author": "LEE TECH",
  "license": "ISC",
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@hapi/boom": "^10.0.1",
    "@types/node": "^18.0.6",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "awesome-phonenumber": "^5.11.0",
    "axios": "^1.14.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "cookie": "^0.5.0",
    "dotenv": "^16.4.5",
    "events": "^3.3.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "groq-sdk": "^1.6.0",
    "gtts": "^0.2.1",
    "human-readable": "^0.2.1",
    "jimp": "^1.6.0",
    "jsdom": "^22.1.0",
    "libphonenumber-js": "^1.11.18",
    "libsignal": "6.0.0",
    "moment-timezone": "^0.5.43",
    "mumaker": "^2.0.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-id3": "^0.2.3",
    "node-webpmux": "^3.1.0",
    "node-youtube-music": "^0.8.0",
    "patch-package": "^8.0.1",
    "performance-now": "^2.1.0",
    "phin": "^3.7.1",
    "pino": "^8.21.0",
    "qrcode": "^1.5.0",
    "ruhend-scraper": "^8.3.0",
    "safe-stable-stringify": "^2.5.0",
    "set-cookie": "^0.0.4",
    "tough-cookie": "^5.0.0",
    "ws": "^8.17.1",
    "yargs": "^17.6.0",
    "yargs-parser": "^21.1.1",
    "youtubedl-core": "^4.11.7",
    "yt-search": "^2.12.1",
    "ytdl-core": "^4.11.5"
  },
  "overrides": {
    "jimp": "^1.6.0",
    "libsignal": "6.0.0",
    "@whiskeysockets/baileys": {
      "libsignal": "6.0.0"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  }
}
